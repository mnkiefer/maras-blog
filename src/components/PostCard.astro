---
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  class="post-card"
  href={`${base}/writing/${post.slug}/`}
>
  <div class="post-body">
    <span class="post-meta">{post.category}</span>
    <h2>{post.title}</h2>
    <p>{post.excerpt}</p>
    <div class="post-bottom">
      <time datetime={post.dateTime}>{post.date}</time> · {post.readTime}
    </div>
  </div>
</a>

<style>
  .post-card {
    display: block;
    padding: 24px 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    transition: none;
    overflow: visible;
  }

  .post-card:hover {
    transform: none;
    box-shadow: none;
  }

  .post-card:hover h2,
  .post-card:focus-visible h2 {
    text-decoration-color: currentColor;
  }

  .post-body {
    padding: 0;
  }

  .post-meta {
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
  }

  .post-body h2 {
    margin: 8px 0;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .post-body p {
    margin: 0 0 12px;
    min-height: 0;
    font-size: 15px;
  }

  .post-bottom {
    display: block;
    border: 0;
    padding: 0;
    margin: 0;
    color: var(--sub);
    font-size: 13px;
  }
</style>
