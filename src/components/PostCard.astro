---
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
  class="post-card"
  href={`${base}/writing/${post.slug}/`}
  data-category={post.category}
>
  <div class:list={['post-visual', post.tone]}>
    <span class:list={['visual-shape', { 'word-symbol': post.symbol.length > 1 }]}>{post.symbol}</span>
  </div>
  <div class="post-body">
    <span class="post-meta">{post.category}</span>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <div class="post-bottom">
      <span><time datetime={post.dateTime}>{post.date}</time> · {post.readTime}</span>
      <span aria-hidden="true">↗</span>
    </div>
  </div>
</a>

<style>
  .visual-shape.word-symbol {
    font-size: 42px;
    letter-spacing: -2px;
  }
</style>
