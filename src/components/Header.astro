---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="wordmark" href={`${base}/#home`} aria-label="Mara’s Blog home">
      Mara’s Blog<span class="wordmark-dot">.</span>
    </a>
    <nav aria-label="Main navigation">
      <a href={`${base}/#articles`}>Writing</a>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    height: 72px;
  }

  .wordmark {
    line-height: 1.15;
    color: #ad5b39;
  }

  nav {
    font-size: 14px;
  }

  @media (max-width: 700px) {
    nav {
      display: flex;
      position: static;
      padding: 0;
      border: 0;
    }
  }
</style>
