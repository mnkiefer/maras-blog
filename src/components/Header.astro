---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="wordmark" href={`${base}/#home`} aria-label="Mara’s Blog home">Mara’s Blog</a>
  </div>
</header>

<style>
  .nav-wrap {
    height: 72px;
  }

  .wordmark {
    line-height: 1.15;
    color: #ad5b39;
  }
</style>
