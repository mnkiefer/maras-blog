---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="wordmark" href={`${base}/#home`} aria-label="Mara’s Blog home">
      Mara’s Blog<span class="wordmark-dot">.</span>
      <span class="wordmark-subtitle">Research, AI &amp; the ideas in between.</span>
    </a>
    <nav aria-label="Main navigation">
      <a href={`${base}/#articles`}>Writing</a>
    </nav>
  </div>
</header>

<style>
  .wordmark {
    line-height: 1.15;
  }

  .wordmark-subtitle {
    display: block;
    margin-top: 5px;
    color: var(--sub);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 700px) {
    nav {
      display: flex;
      position: static;
      padding: 0;
      border: 0;
    }
  }
</style>
