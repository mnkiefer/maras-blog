---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleFigure from '../../components/ArticleFigure.astro';
import { posts, type Post } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${post.title} — Mara’s Notes`} description={post.excerpt}>
  <main>
    <div class="shell article-shell">
      <a href={`${base}/#articles`} class="back-link">← All writing</a>
      <article id="article-content">
        <div class="article-category">{post.category} · <time datetime={post.dateTime}>{post.date}</time> · {post.readTime}</div>
        <h1 class="article-title">{post.title}</h1>
        <p class="article-deck">{post.intro}</p>
        <div class="article-prose">
          {post.sections.map((section) => (
            <section class:list={{ 'section-with-aside': section.figure?.placement.startsWith('aside-') }}>
              <h2>{section.heading}</h2>
              {section.figure && section.figure.placement.startsWith('aside-') && <ArticleFigure figure={section.figure} />}
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.figure && !section.figure.placement.startsWith('aside-') && <ArticleFigure figure={section.figure} />}
            </section>
          ))}
          <section class="article-sources" aria-labelledby="sources-heading">
            <h2 id="sources-heading">Further reading</h2>
            <ul>
              <li><a href="https://githubnext.github.io/gh-cao/">Central Agentic Ops: Official site</a></li>
              <li><a href="https://githubnext.github.io/gh-cao/architecture-at-a-glance/">What is Central Agentic Ops?</a></li>
              <li><a href="https://github.github.com/gh-aw/">GitHub Agentic Workflows</a></li>
            </ul>
          </section>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .article-shell {
    max-width: 1180px;
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .back-link {
    display: block;
    max-width: 42rem;
    margin-inline: auto;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #article-content {
    max-width: 42rem;
    margin: 40px auto 0;
  }

  .article-category {
    font-size: 13px;
    letter-spacing: 0;
    font-weight: 500;
  }

  .article-title {
    font-size: clamp(36px, 5vw, 58px);
    letter-spacing: -1px;
    line-height: 1.15;
    margin: 14px 0;
  }

  .article-deck {
    font-size: 18px;
    line-height: 1.6;
  }

  .article-prose {
    font-size: 20px;
  }

  .article-prose h2 {
    font-size: 32px;
  }

  .article-prose a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .article-prose a:hover {
    color: var(--ink);
  }

  .section-with-aside {
    display: flow-root;
  }

  .article-sources {
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }

  .article-sources ul {
    padding-left: 1.2em;
    font-size: 0.85em;
  }

  .article-sources li {
    margin-bottom: 12px;
  }

  @media (max-width: 700px) {
    .article-title {
      font-size: clamp(34px, 8vw, 44px);
    }

    .article-deck {
      font-size: 18px;
    }
  }
</style>
