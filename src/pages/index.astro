---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildDate = new Date();
const buildDateISO = buildDate.toISOString().slice(0, 10);
const buildDateLabel = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(buildDate);
---

<BaseLayout>
  <main>
    <div class="hero shell" id="home">
      <img
        class="hero-art"
        src={`${base}/hero.png`}
        alt="Illustration of a researcher sitting with a laptop beside her playful black schnauzer puppy"
        width="1774"
        height="887"
        decoding="async"
      />
    </div>

    <section class="articles-section shell" id="articles">
      <div class="posts-list">
        <h1>Recent posts</h1>
        <div class="article-grid" id="article-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
        <p class="last-updated">Last updated <time datetime={buildDateISO}>{buildDateLabel}</time></p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: block;
    min-height: 0;
    overflow: visible;
    padding-top: 24px;
  }

  .hero-art {
    position: static;
    display: block;
    width: min(100%, 760px);
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    mask-image: none;
  }

  .articles-section {
    padding-top: 32px;
    padding-bottom: 80px;
  }

  .posts-list {
    max-width: 760px;
  }

  .posts-list h1 {
    font-size: clamp(30px, 3vw, 38px);
    letter-spacing: -0.5px;
    margin: 0;
  }

  .article-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin-top: 12px;
  }

  .last-updated {
    margin: 24px 0 0;
    color: var(--sub);
    font-size: 13px;
    line-height: 1.5;
    text-align: right;
  }

  @media (max-width: 700px) {
    .hero {
      padding-top: 16px;
    }

    .articles-section {
      padding-top: 32px;
      padding-bottom: 64px;
    }
  }
</style>
