---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildDate = new Date();
const buildDateISO = buildDate.toISOString().slice(0, 10);
const buildDateLabel = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(buildDate);
---

<BaseLayout>
  <main>
    <section class="hero shell" id="home">
      <div class="hero-copy">
        <h1>Research and AI</h1>
        <p>Notes on artificial intelligence, research, and the questions worth exploring.</p>
        <div class="hero-actions">
          <a class="button primary" href="#articles">Read the blog</a>
        </div>
      </div>
      <img
        class="hero-art"
        src={`${base}/hero.png`}
        alt="Illustration of a researcher sitting with a laptop beside her playful black schnauzer puppy"
      />
    </section>

    <section class="articles-section shell" id="articles">
      <div class="posts-list">
        <h2>Recent posts</h2>
        <div class="article-grid" id="article-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
        <p class="last-updated">Last updated <time datetime={buildDateISO}>{buildDateLabel}</time></p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 360px;
  }

  .hero-copy {
    width: 52%;
    max-width: 550px;
    padding: 48px 0;
  }

  .hero h1 {
    font-size: clamp(38px, 5vw, 56px);
    letter-spacing: -1.5px;
    margin: 0 0 12px;
  }

  .hero-copy > p {
    max-width: 460px;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .hero-actions {
    margin-top: 24px;
  }

  .hero-art {
    right: 5%;
    width: 55%;
    bottom: 0;
    mask-image: linear-gradient(to right, transparent, black 35%);
  }

  .articles-section {
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .posts-list {
    max-width: 760px;
  }

  .posts-list h2 {
    font-size: clamp(30px, 3vw, 38px);
    letter-spacing: -0.5px;
    margin: 0;
  }

  .article-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin-top: 12px;
  }

  .last-updated {
    margin: 24px 0 0;
    color: var(--sub);
    font-size: 13px;
    line-height: 1.5;
    text-align: right;
  }

  @media (max-width: 700px) {
    .hero {
      display: block;
      min-height: 0;
    }

    .hero-copy {
      width: 100%;
      padding: 40px 0 20px;
    }

    .hero-art {
      position: static;
      display: block;
      width: 100%;
      mask-image: none;
    }

    .articles-section {
      padding-top: 36px;
      padding-bottom: 64px;
    }
  }
</style>
