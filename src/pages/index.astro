---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ['All', ...new Set(posts.map((post) => post.category))];
---

<BaseLayout>
  <main>
    <section class="hero shell" id="home">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> RESEARCH &amp; AI</div>
        <h1>Curiosity,<br /><em>carefully considered.</em></h1>
        <p>Notes on artificial intelligence, the craft of research, and the questions that make us think twice.</p>
        <div class="hero-actions">
          <a class="button primary" href="#articles">Read the blog <span>↗</span></a>
        </div>
      </div>
      <img
        class="hero-art"
        src={`${base}/hero.png`}
        alt="Illustration of a researcher sitting with a laptop beside her playful black schnauzer puppy"
      />
    </section>

    <section class="articles-section shell" id="articles">
      <div class="section-heading">
        <div><h2>Recent writing<span class="accent">.</span></h2></div>
      </div>
      {posts.length > 1 && (
        <div class="filters" role="group" aria-label="Filter articles">
          {categories.map((category, index) => (
            <button class:list={['filter', { active: index === 0 }]} data-filter={category}>
              {category === 'All' ? 'All writing' : category}
            </button>
          ))}
        </div>
      )}
      <div class:list={['article-grid', { 'single-article': posts.length === 1 }]} id="article-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 430px;
  }

  .hero-copy {
    padding: 48px 0 56px;
  }

  .hero h1 {
    font-size: clamp(44px, 4.5vw, 66px);
    margin: 22px 0 18px;
  }

  .hero-copy > p {
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 22px;
  }

  .eyebrow {
    font-size: 12px;
    letter-spacing: 1.8px;
  }

  .hero-art {
    right: 5%;
    width: 56%;
    bottom: 0;
    mask-image: linear-gradient(to right, transparent, black 35%);
  }

  .articles-section {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  .section-heading {
    margin-bottom: 30px;
  }

  .section-heading h2 {
    font-size: clamp(38px, 4vw, 58px);
    margin-top: 0;
  }

  .article-grid.single-article {
    grid-template-columns: minmax(0, 440px);
  }

  @media (max-width: 1000px) {
    .hero-copy {
      width: 58%;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 0;
    }

    .hero-copy {
      width: 100%;
      padding: 36px 0 16px;
    }

    .hero h1 {
      font-size: clamp(40px, 8vw, 56px);
      letter-spacing: -2px;
    }

    .hero-art {
      position: static;
      display: block;
      width: 100%;
      mask-image: none;
    }

    .articles-section {
      padding-top: 42px;
      padding-bottom: 64px;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      filters.forEach((filter) => filter.classList.remove('active'));
      button.classList.add('active');

      cards.forEach((card) => {
        card.hidden = button.dataset.filter !== 'All'
          && card.dataset.category !== button.dataset.filter;
      });
    });
  });
</script>
